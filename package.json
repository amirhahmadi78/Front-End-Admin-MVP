{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "com.clinicApp.app",
    "productName": "My Clinic",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "electron": "electron .",
    "dist": "electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "mock:api": "json-server --watch ./src/mocks/db.json --port 3001 --host 0.0.0.0"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/dotenv": "^6.1.1",
    "@types/moment-jalaali": "^0.7.9",
    "@types/react-select": "^5.0.0",
    "axios": "^1.13.4",
    "dotenv": "^17.2.3",
    "lucide-react": "^1.34.0",
    "moment-jalaali": "^0.10.4",
    "msw": "^2.12.7",
    "react": "^19.2.0",
    "react-date-object": "^2.1.9",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-multi-date-picker": "^4.5.2",
    "react-router-dom": "^7.13.0",
    "react-select": "^5.10.2",
    "react-toastify": "^11.0.5",
    "sweetalert2": "^11.26.18",
    "yup": "^1.7.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^24.10.10",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "json-server": "^1.0.0-beta.5",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
